# ===========================================
# SmartBuild API - Environment Variables
# ===========================================

# Database
DATABASE_URL="mysql://user:password@localhost:3306/smartbuild"

# JWT Secret
SECRET_JWT=your-secret-key-here

# URLs
URL_FRONT="http://localhost:5173"
URL_API="http://localhost:4003"

# QuickBooks Integration
QUICKBOOKS_CLIENT_ID=your-client-id
QUICKBOOKS_CLIENT_SECRET=your-client-secret
QBO_WEBHOOK_VERIFIER_TOKEN=your-webhook-verifier-token
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CALLBACK_PATH="/quickbooks/callback"

# Redis
REDIS_URL="redis://127.0.0.1:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Mobile auth and store subscriptions
# Either map store products directly to Plan IDs:
MOBILE_APP_PRODUCTS_JSON={"smartbuild_pro_monthly_29":"PLAN_ID_29","smartbuild_pro_monthly_99":"PLAN_ID_99"}
# Or provide only allowed product IDs and let the API infer by plan price 29/99:
MOBILE_APP_PRODUCT_IDS=smartbuild_pro_monthly_29,smartbuild_pro_monthly_99
MOBILE_APP_PRODUCT_ID=smartbuild_pro_monthly_29
MOBILE_APP_PLAN_ID=
ALLOW_MOBILE_STORE_TEST_PURCHASES=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_PLAY_PACKAGE_NAME=com.anonymous.smartbuildadminapp
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_BUNDLE_ID=com.struxpro.app
APP_STORE_BUNDLE_ID=com.struxpro.app
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=

# Stripe Extra Employee Product
# Default price in cents (e.g., 1000 = $10.00)
# This value is used only when creating the ExtraEmployeeConfig for the first time
# After that, the price is managed via the database
STRIPE_PRICE_EXTRA_EMPLOYEE=1000

# Rewardful
REWARDFUL_API_SECRET=your-rewardful-api-secret
REWARDFUL_API_KEY=your-rewardful-api-key

# Tracking 2.0 remote configuration
# These values are the safe fallback/bootstrap configuration. Once a Master saves
# a global configuration, the database value takes precedence; company overrides
# then inherit every field they do not explicitly replace. The two rollback flags
# below remain authoritative in their safe direction even when database rows exist.
# Emergency rollback recipe: set TRACKING_V2_ENABLED=false and
# TRACKING_LEGACY_TIMELINE_WRITE=true, then restart the API.
TRACKING_V2_ENABLED=true
TRACKING_LEGACY_TIMELINE_WRITE=false
TRACKING_KEEPALIVE_MS=120000
TRACKING_AUTO_MIN_SEND_INTERVAL_MS=60000
TRACKING_MANUAL_MIN_SEND_INTERVAL_MS=30000
TRACKING_OUTSIDE_DISTANCE_METERS=200
TRACKING_INSIDE_MIN_DISTANCE_METERS=10
TRACKING_FOREGROUND_MIN_INTERVAL_MS=60000
TRACKING_FOREGROUND_MIN_DISTANCE_METERS=100
TRACKING_QUEUE_LIMIT=480
TRACKING_SOCKET_REFRESH_THROTTLE_MS=5000
TRACKING_CONFIG_TTL_MS=900000

# Tracking retention (small batches avoid long-running delete locks)
WORKER_TRACKING_RETENTION_DAYS=7
WORKER_TRACKING_PRUNE_BATCH_SIZE=1000
WORKER_TRACKING_PRUNE_CRON="17 3 * * *"
WORKER_TRACKING_PRUNE_TIMEZONE=UTC
