# REFERENCE ONLY. No secrets. Do not overwrite the server .env.
# Keep disabled during migration/build; enable both only for the isolated HML test.
GOOGLE_PLAY_NATIVE_ENABLED=false
BILLING_COORDINATION_ENABLED=false
GOOGLE_PLAY_ACCEPT_LIVE_PURCHASES=false
ALLOW_MOBILE_STORE_TEST_PURCHASES=false
GOOGLE_PLAY_TEST_COMPANY_IDS=REPLACE_WITH_DEDICATED_HML_COMPANY_ID
GOOGLE_PLAY_PACKAGE_NAME=com.anonymous.smartbuildadminapp
# Confirm these public plan IDs against the HML catalog before activation.
ANDROID_BILLING_PLAN_MAPPINGS=[{"planId":"4ee81776-538a-4e45-99eb-c7d32fcadc16","productId":"smartbuild_starter_monthly","basePlanId":"monthly"},{"planId":"d52f1833-119d-4024-beb9-7fa767ce23b7","productId":"smartbuild_essentials_monthly","basePlanId":"monthly"}]
# Supply privately on HML. Never commit the populated JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_AUDIENCE=https://apismartbuild.codelabsusa.com/mobile-subscriptions/webhooks/google
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=
# Historical alternative billing stays OFF.
ANDROID_BILLING_ENABLED=false
ANDROID_BILLING_REPORTING_ENABLED=false
ANDROID_BILLING_BR_APPROVED=false
ANDROID_BILLING_US_APPROVED=false
SUBSCRIPTION_ACCESS_COMPARE=false
